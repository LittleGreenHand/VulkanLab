#usda 1.0
(
    endTimeCode = 0
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "material_black_001"
    {
        custom token[] omni:simready:nonvisual:attributes = ["none"]
        custom token omni:simready:nonvisual:base = "aluminum"
        custom token omni:simready:nonvisual:coating = "paint"
        token outputs:mdl:displacement.connect = </Materials/material_black_001/Shader.outputs:out>
        token outputs:mdl:surface.connect = </Materials/material_black_001/Shader.outputs:out>
        token outputs:mdl:volume.connect = </Materials/material_black_001/Shader.outputs:out>

        def Shader "Shader"
        {
            uniform token info:id
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            color3f inputs:diffuse_color_constant = (0, 0, 0) (
                customData = {
                    float3 default = (0.2, 0.2, 0.2)
                }
                displayGroup = "Albedo"
                displayName = "Albedo Color"
                doc = "This is the albedo base color"
                hidden = false
                renderType = "color"
            )
            color3f inputs:emissive_color = (0, 0, 0) (
                customData = {
                    float3 default = (1, 0.1, 0.1)
                }
                displayGroup = "Emissive"
                displayName = "Emissive Color"
                doc = "The emission color"
                hidden = false
                renderType = "color"
            )
            token outputs:out
        }
    }

