            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -149.99977
            float physics:upperLimit = 179.99985
            float state:angular:physics:position = 0.000060095703
            float state:angular:physics:velocity = 0
        }
    }

