#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (-1.325775300113189, 0.13250527481682373, 0.5756606489421192)
                double3 target = (6.490853026073124, 0.6013935022045278, -3.123050672650708)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./spot.usd"
        }
        dictionary renderSettings = {
        }
    }
    endTimeCode = 0
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "material_Material"
    {
        custom token[] omni:simready:nonvisual:attributes = ["none"]
        custom token omni:simready:nonvisual:base = "plastic"
        custom token omni:simready:nonvisual:coating = "none"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/material_Material/Shader.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/material_Material/Shader.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/material_Material/Shader.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "Shader" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @OmniPBR.mdl@
            token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            color3f inputs:diffuse_color_constant = (1, 1, 1)
            asset inputs:diffuse_texture = @../Textures/hip.png@
            color3f inputs:emissive_color = (0, 0, 0)
            token outputs:out
        }
    }

