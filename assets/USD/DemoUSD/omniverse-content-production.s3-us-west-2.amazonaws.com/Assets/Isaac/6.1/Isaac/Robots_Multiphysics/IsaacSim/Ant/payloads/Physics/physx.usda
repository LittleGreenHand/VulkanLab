        over "collisions"
        {
            over "fourth_ankle_geom"
            {
                float physxCollision:contactOffset = 0.02
                float physxCollision:restOffset = 0
            }
        }
    }
}

over "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
}

