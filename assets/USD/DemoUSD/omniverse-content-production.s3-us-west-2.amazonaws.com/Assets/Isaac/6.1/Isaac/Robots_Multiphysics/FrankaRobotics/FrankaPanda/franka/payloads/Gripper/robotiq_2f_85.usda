def Xform "panda"
{
    def "Robotiq_2F_85" (
        delete apiSchemas = ["PhysicsArticulationRootAPI"]
        prepend payload = @../../../../../Robotiq/2F-85/Robotiq_2F_85.usda@
    )
    {
        float3 xformOp:rotateZYX = (-180, -9.044342e-8, -45.000015)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.08799996972084045, -4.865228930839294e-8, 0.9259999394416809)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

        over "base_link"
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </panda/panda_hand>
                rel physics:body1 = </panda/Robotiq_2F_85/base_link>
                point3f physics:localPos0 = (-9.7144515e-17, 1.8735014e-16, 1.110223e-16)
                point3f physics:localPos1 = (-3.0531133e-16, 6.661338e-16, 2.220446e-16)
                quatf physics:localRot0 = (1, -5.2630216e-9, -5.2630247e-9, -1.9715232e-8)
                quatf physics:localRot1 = (1, 3.7215186e-9, 3.7215206e-9, 1.3940775e-8)
            }
        }

        over "Joints"
        {
            over "finger_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_outer_knuckle_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_inner_finger_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_inner_finger_knuckle_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "left_inner_finger_knuckle_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "left_inner_finger_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }

        over "left_outer_knuckle"
        {
        }

        over "left_outer_finger"
        {
        }

        over "left_inner_finger"
        {
        }

        over "left_inner_knuckle"
        {
        }

        over "right_outer_knuckle"
        {
        }

        over "right_outer_finger"
        {
        }

        over "right_inner_finger"
        {
        }

        over "right_inner_knuckle"
        {
        }
    }

    over "panda_link0"
    {
        over "panda_joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }

    over "panda_link1"
    {
        over "panda_joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }

    over "panda_link2"
