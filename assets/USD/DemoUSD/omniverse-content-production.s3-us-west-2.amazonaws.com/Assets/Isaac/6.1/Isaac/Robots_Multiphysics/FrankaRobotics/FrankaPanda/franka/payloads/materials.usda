                    dictionary range = {
                        float3 max = (100000, 100000, 100000)
                        float3 min = (0, 0, 0)
                    }
                }
                displayGroup = "Emissive"
                doc = "The emission color"
            )
            float inputs:emissive_intensity = 29000 (
                customData = {
                    double default = 40
                    dictionary range = {
                        double max = 100000
                        double min = -100000
                    }
                }
                displayGroup = "Emissive"
                doc = "Intensity of the emission"
            )
            bool inputs:enable_emission = 1 (
                customData = {
                    bool default = 0
                }
                displayGroup = "Emissive"
                doc = "Enables the emission of light from the material"
            )
            float inputs:reflection_roughness_constant = 0.298 (
                customData = {
                    double default = 0.5
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Reflectivity"
                doc = "Higher roughness values lead to more blurry reflections"
